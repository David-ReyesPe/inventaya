# InventaYa - variables de ejemplo.
# Copie este archivo a ".env" (cp .env.example .env) antes de levantar el stack.
# Todos los valores son de DESARROLLO LOCAL; no hay secretos reales. Si no existe .env,
# docker-compose.yml usa estos mismos valores como predeterminados.

# --- PostgreSQL ---
POSTGRES_DB=inventaya_db
POSTGRES_USER=inventaya
POSTGRES_PASSWORD=cambiar-en-produccion

# --- pgAdmin (opcional, solo para inspeccionar la base) ---
PGADMIN_EMAIL=admin@inventaya.com
PGADMIN_PASSWORD=cambiar-en-produccion

# --- Spring Boot (servicio-ventas y servicio-inventario) ---
# "dev" habilita GET /api/dev/token (emisor de JWT de prueba). Use otro perfil fuera de desarrollo.
SPRING_PROFILES_ACTIVE=dev

# Clave simetrica HMAC compartida por ambos servicios (minimo 32 caracteres).
INVENTAYA_JWT_SECRET=clave-jwt-de-ejemplo-solo-para-desarrollo-local-32chars
